{
  "name": "@6g-path/gaussian-content-tools",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "gs-content": "./bin/gs-manifest.mjs",
    "gs-manifest": "./bin/gs-manifest.mjs"
  },
  "files": [
    "bin",
    "dist",
    "rust"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/node.ts src/cli.ts --format esm --dts --sourcemap --clean",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@6g-path/gaussian-player": "workspace:*",
    "@playcanvas/splat-transform": "3.0.0"
  }
}
