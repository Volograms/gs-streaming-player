{
  "name": "@6g-path/gaussian-player",
  "version": "0.0.0",
  "type": "module",
  "files": [
    "dist",
    "schemas"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema/gaussian-sequence-manifest.schema.json": "./schemas/gaussian-sequence-manifest.schema.json"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@6g-path/gaussian-codec": "workspace:*",
    "@6g-path/shared": "workspace:*",
    "ajv": "^8.20.0",
    "typebox": "^1.3.6"
  }
}
