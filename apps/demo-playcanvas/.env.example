VITE_DYNAMIC_QUALITY_INDEX_URL=/assets/local-dynamic-cuts-sog/quality-cuts.json
VITE_DYNAMIC_RAD_START_FRAME=1
VITE_DYNAMIC_RAD_END_FRAME=100
VITE_DYNAMIC_RAD_FRAME_RATE=30
VITE_DYNAMIC_FRAME_CODEC=sog-v2

VITE_DYNAMIC_COMPRESSED_BUFFER_MB=200
VITE_DYNAMIC_FETCH_CONCURRENCY=6
VITE_DYNAMIC_PREPARE_CONCURRENCY=2
VITE_DYNAMIC_FUTURE_FRAMES=10

# Use webgpu for PlayCanvas GPU sort, or webgl2 for the CPU-sort baseline.
# A webgpu request fails if the browser falls back instead of silently
# producing a mislabeled benchmark.
VITE_PLAYCANVAS_GRAPHICS_BACKEND=webgl2

# Keep the requested graphics backend by default. Set this to true only for an XR run
# where webgpu cannot host immersive-vr because the browser lacks XRGPUBinding, and
# WebGL2 fallback is preferable to strict WebGPU measurement.
VITE_PLAYCANVAS_XR_BACKEND_FALLBACK=false

# Shows an explicit Enter VR button when immersive-vr is available.
VITE_ENABLE_XR=true

# WebXR requires a secure origin. Generate the ignored .cert files as documented.
# Use 0.0.0.0 only when testing from another device on your LAN.
VITE_HTTPS=false
VITE_HOST=127.0.0.1
