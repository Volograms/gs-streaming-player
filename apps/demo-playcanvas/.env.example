# Optional when VITE_STATIC_GS_URL is configured. Leave blank for a static-only test.
VITE_DYNAMIC_QUALITY_INDEX_URL=/assets/local-dynamic-cuts-sog/quality-cuts.json
VITE_DYNAMIC_RAD_START_FRAME=1
VITE_DYNAMIC_RAD_END_FRAME=100
VITE_DYNAMIC_RAD_FRAME_RATE=30
VITE_DYNAMIC_FRAME_CODEC=sog-v2
# World-space offset applied only to the dynamic sequence.
VITE_DYNAMIC_GS_POSITION_X=0
VITE_DYNAMIC_GS_POSITION_Y=0
VITE_DYNAMIC_GS_POSITION_Z=0

VITE_DYNAMIC_COMPRESSED_BUFFER_MB=200
VITE_DYNAMIC_FETCH_CONCURRENCY=6
VITE_DYNAMIC_PREPARE_CONCURRENCY=2
VITE_DYNAMIC_FUTURE_FRAMES=10

# Optional static PlayCanvas gsplat/SOG environment for final-scene tests.
# Bundled .sog or Streamed SOG /lod-meta.json URL.
VITE_STATIC_GS_URL=
# Signed uniform scale. Negative values are preserved.
VITE_STATIC_GS_SCALE=1
# Optional X-axis correction in degrees, for example 180 for an upside-down asset.
VITE_STATIC_GS_ROTATION_X_DEGREES=0
# World-space offset applied only to the static scene. Adjust Y to place its captured
# floor at world height 0 without moving the dynamic sequence.
VITE_STATIC_GS_POSITION_X=0
VITE_STATIC_GS_POSITION_Y=0
VITE_STATIC_GS_POSITION_Z=0
# Optional exported Streamed SOG LOD index to pin. 0 is finest; blank is automatic.
VITE_STATIC_GS_LOD_LEVEL=
# Global PlayCanvas streamed-octree budget. 0 is unlimited.
VITE_PLAYCANVAS_SPLAT_BUDGET=0

# WebGPU pre-sort rejection controls. PlayCanvas defaults are 2 pixels and 3
# contribution units. Higher values sort and draw fewer low-impact splats.
VITE_PLAYCANVAS_GSPLAT_MIN_PIXEL_SIZE=2
VITE_PLAYCANVAS_GSPLAT_MIN_CONTRIBUTION=3
# Increase the contribution threshold toward the view periphery. Strength 0 disables
# foveation; the center is a normalized screen radius from 0 to 1.
VITE_PLAYCANVAS_GSPLAT_FOVEATION_STRENGTH=0
VITE_PLAYCANVAS_GSPLAT_FOVEATION_CENTER=0.3

# Forward-pass opacity cutoff in normalized alpha units. PlayCanvas defaults to 1 / 255.
VITE_PLAYCANVAS_GSPLAT_ALPHA_CLIP_FORWARD=0.00392156862745098

# Sample two WebGPU-timestamped frames at this interval and aggregate them in the UI.
# Use 0 to disable. The minimum non-zero interval is 250 ms; 2000 ms is the low-overhead default.
VITE_PLAYCANVAS_GPU_TIMING_INTERVAL_MS=2000

# Use webgpu for PlayCanvas GPU sort, or webgl2 for the CPU-sort baseline.
# A webgpu request fails if the browser falls back instead of silently
# producing a mislabeled benchmark.
VITE_PLAYCANVAS_GRAPHICS_BACKEND=webgpu
# Auto uses PlayCanvas GPU sorting on WebGPU and asynchronous CPU sorting on WebGL2.
# Set cpu for a WebGPU CPU-sort A/B test; this retains CPU splat centers and uses
# more memory.
VITE_PLAYCANVAS_GSPLAT_SORT=auto

# Keep the requested graphics backend by default. Set this to true only for an XR run
# where webgpu cannot host immersive-vr because the browser lacks XRGPUBinding, and
# WebGL2 fallback is preferable to strict WebGPU measurement.
VITE_PLAYCANVAS_XR_BACKEND_FALLBACK=false

# Shows an explicit Enter VR button when immersive-vr is available.
VITE_ENABLE_XR=true
# WebXR fixed foveation from 0 (off) to 1 (maximum), when supported by the active
# XR layer.
VITE_PLAYCANVAS_XR_FIXED_FOVEATION=0

# Experimental Quest-only bridge test: run PlayCanvas on WebGPU, start a separate
# WebGL2 WebXR presenter, and mirror the WebGPU canvas into both XR eyes. This is a
# mono handoff-cost test, not final stereo scene rendering.
VITE_PLAYCANVAS_XR_MIRROR=false

# WebXR requires a secure origin. Generate the ignored .cert files as documented.
# Use 0.0.0.0 only when testing from another device on your LAN.
VITE_HTTPS=false
VITE_HOST=127.0.0.1
