# Optional local-only static Spark asset staged under apps/demo/public/assets.
VITE_STATIC_RAD_URL=/assets/local-static.rad

# Optional local-only per-frame sequence. Defaults to frames 40-50 at 30 fps.
VITE_DYNAMIC_RAD_BASE_URL=/assets/local-dynamic
# Optional generated flat-SPZ quality index. When set, dynamic transfer uses these
# tiers and the RAD URL above remains a fallback.
VITE_DYNAMIC_QUALITY_INDEX_URL=/assets/local-dynamic-cuts/quality-cuts.json
VITE_DYNAMIC_RAD_START_FRAME=40
VITE_DYNAMIC_RAD_END_FRAME=50
VITE_DYNAMIC_RAD_FRAME_RATE=30

# Diagnostic mode: retain and prepare the complete configured sequence before
# enabling playback. This can consume substantial CPU and GPU memory.
VITE_DYNAMIC_PRELOAD_ALL_FRAMES=false

# Optional HTTPS. Generate the ignored .cert files using the command in the README.
# Use 0.0.0.0 only when testing from another device on your LAN.
VITE_HTTPS=false
VITE_HOST=127.0.0.1
