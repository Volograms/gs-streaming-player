# Public, redistributable manifest hosted with CORS. Leave blank for the picker state.
VITE_DEFAULT_MANIFEST_URL=
VITE_GITHUB_URL=https://github.com/volograms/gs-streaming-player

# Local development only: serve this external dataset directory as Vite's public root.
# Relative paths resolve from the repository root; absolute Windows paths are supported.
# If this directory contains manifest.json, set VITE_DEFAULT_MANIFEST_URL=/manifest.json.
SHOWCASE_LOCAL_DATASET_DIR=

# WebXR testing from a headset requires HTTPS and a LAN-accessible host.
VITE_ENABLE_XR=true
VITE_HTTPS=false
VITE_HOST=127.0.0.1
VITE_BASE_PATH=./
