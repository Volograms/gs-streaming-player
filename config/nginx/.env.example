# Copy to config/nginx/.env, then pass --env-file config/nginx/.env to Compose.
# Default mounts use this checkout's 6G showcase public directory and .cert files.
ASSET_BIND_ADDRESS=0.0.0.0
ASSET_HTTP_PORT=8080
ASSET_PORT=8443

# Optional RAM-cache profile: 5 GiB cached data, 6 GiB tmpfs, 7 GiB container RAM.
# Include compose.ram-cache.yaml in the startup/recreate command to activate it.
# ASSET_CACHE_MAX_SIZE_BYTES=5368709120
# ASSET_CACHE_SIZE_BYTES=6442450944
# ASSET_CACHE_MEMORY_LIMIT_BYTES=7516192768
# ASSET_CACHE_HEADROOM_BYTES=536870912

# For another machine, use absolute host paths and its TLS certificate/key:
# ASSET_PUBLIC_DIR=/srv/gs-streaming/public
# ASSET_CERT_FILE=/etc/ssl/gs-streaming/fullchain.pem
# ASSET_KEY_FILE=/etc/ssl/gs-streaming/privkey.pem
# Use 0.0.0.0 to accept connections from other devices.
