{
  "name": "gs-streaming-player",
  "version": "0.0.0",
  "private": true,
  "description": "Source-only Volograms 4DGS streaming player public preview",
  "homepage": "https://volograms.github.io/gs-streaming-player/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Volograms/gs-streaming-player.git"
  },
  "bugs": {
    "url": "https://github.com/Volograms/gs-streaming-player/issues"
  },
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "clean": "pnpm --recursive --if-present clean",
    "dev": "pnpm --filter @6g-path/demo dev",
    "dev:babylon": "pnpm --filter @6g-path/demo-babylon dev",
    "dev:playcanvas": "pnpm --filter @6g-path/demo-playcanvas dev",
    "dev:showcase": "pnpm --filter @6g-path/showcase dev",
    "dev:spark": "pnpm --filter @6g-path/demo dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gs-content": "tsx packages/content-tools/src/cli.ts",
    "gs-manifest": "tsx packages/content-tools/src/cli.ts",
    "lint": "eslint . --max-warnings 0",
    "profile:demo": "pnpm build && pnpm --filter @6g-path/demo preview --port 4174",
    "profile:babylon": "pnpm build && pnpm --filter @6g-path/demo-babylon preview --port 4176",
    "profile:playcanvas": "pnpm build && pnpm --filter @6g-path/demo-playcanvas preview --port 4178",
    "profile:showcase": "pnpm build && pnpm --filter @6g-path/showcase preview --port 4180",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:performance": "node scripts/run-e2e.mjs tests/e2e/playback.performance.spec.ts",
    "typecheck": "pnpm --recursive --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
